#!/usr/bin/env bash
# Consistent snapshots of the two databases that would hurt to lose:
# 9router's state (accounts, OAuth tokens, quota counters) and the lead
# pipeline. Re-authenticating every provider by hand is what this avoids; the
# leads are simply irreplaceable.
# Same disk as the originals, so this covers corruption and mistakes, not
# disk loss.
set -euo pipefail
python3 - <<'PY'
import sqlite3, datetime, pathlib
dest = pathlib.Path("/root/backups/9router")
dest.mkdir(parents=True, exist_ok=True)
dest.chmod(0o700)
today = datetime.date.today().isoformat()
for name, source in (("data", "/home/agent/.9router/db/data.sqlite"),
                     ("leads", "/opt/ai-assistant/data/leads.db")):
    if not pathlib.Path(source).exists():
        print("skipped (not present):", source)
        continue
    dst = dest / f"{name}-{today}.sqlite"
    src = sqlite3.connect(f"file:{source}?mode=ro", uri=True)
    out = sqlite3.connect(str(dst))
    src.backup(out)      # online backup API: safe while the services run
    out.close(); src.close()
    dst.chmod(0o600)
    print("backed up ->", dst)
PY
# keep the 7 most recent
# A stamp the assistant can stat: the backups themselves stay root-only
# because they contain OAuth tokens.
date -Iseconds > /var/lib/assistant-backup.stamp
chmod 644 /var/lib/assistant-backup.stamp

for prefix in data leads; do
  ls -1t /root/backups/9router/${prefix}-*.sqlite 2>/dev/null | tail -n +8 | xargs -r rm -f
done
