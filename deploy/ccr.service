# claude-code-router: the local gateway that points Claude Code at the free
# models. Bound to localhost — an open router port is a free API-key-draining
# endpoint for whoever finds it.
#
#   cp deploy/ccr.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now ccr
#
# NOTE: confirm the serve subcommand for your installed version with
#   ccr -h
# Current releases use `ccr serve --no-open`; older ones use `ccr start`.
# Fix ExecStart below to match before enabling.

[Unit]
Description=Claude Code Router (free-model gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent

Environment=HOME=/home/agent
Environment=NODE_ENV=production
# Keys for the providers the router forwards to.
EnvironmentFile=/opt/ai-assistant/.env

ExecStart=/usr/bin/ccr serve --no-open

Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/agent

[Install]
WantedBy=multi-user.target
