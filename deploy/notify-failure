#!/usr/bin/env bash
# Tell the phone when a unit dies. Invoked by OnFailure= on the units that
# matter, so a crash announces itself instead of waiting to be noticed at
# 08:00 when the briefing does not arrive.
#
#   install -m 700 deploy/notify-failure /usr/local/bin/notify-failure
set -uo pipefail
UNIT="${1:-unknown}"
ENV_FILE="${ENV_FILE:-/opt/ai-assistant/.env}"

TOKEN=$(grep -m1 '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" | cut -d= -f2-)
CHAT=$(grep -m1 '^TELEGRAM_CHAT_ID=' "$ENV_FILE" | cut -d= -f2-)
[[ -n "$TOKEN" && -n "$CHAT" ]] || exit 0

STATE=$(systemctl is-active "$UNIT" 2>/dev/null)
TAIL=$(journalctl -u "$UNIT" -n 12 --no-pager -o cat 2>/dev/null | tail -c 700)

read -r -d '' TEXT <<EOF || true
🔴 $UNIT è caduto ($STATE)

$TAIL

/status per il quadro completo, /restart $UNIT per riavviarlo.
EOF

curl -s -m 20 -o /dev/null -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
  --data-urlencode "chat_id=${CHAT}" --data-urlencode "text=${TEXT}"
