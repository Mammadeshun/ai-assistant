# 9router — the local AI router (https://github.com/decolua/9router).
#
# Routes Claude Code and other CLI tools through a subscription -> cheap -> free
# fallback chain, and compresses tool output before it reaches the model.
#
#   sudo npm install -g 9router
#   which 9router          # confirm the path below matches
#   cp deploy/9router.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now 9router
#
# Bound to 127.0.0.1 on purpose. The dashboard holds OAuth tokens for your
# Claude, Copilot and Cursor accounts — exposing it on 0.0.0.0 puts your
# subscriptions behind nothing but a JWT secret. Reach it over an SSH tunnel:
#   ssh -L 20128:127.0.0.1:20128 agent@<server-ip>

[Unit]
Description=9router (AI router: subscription -> cheap -> free fallback)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent

Environment=HOME=/home/agent
Environment=NODE_ENV=production
Environment=DATA_DIR=/home/agent/.9router

# The router's own secrets: JWT_SECRET, API_KEY_SECRET, MACHINE_ID_SALT,
# INITIAL_PASSWORD, REQUIRE_API_KEY. Deliberately NOT the app's .env — the
# router has no use for the Telegram token or the portal password, and
# EnvironmentFile hands over the whole file. Root-owned, 0600; systemd reads
# it as root before dropping to the service user.
EnvironmentFile=/etc/9router.env

# --host is the only thing that binds this to localhost. Setting HOSTNAME in
# the environment does nothing: cli.js parses --host (default 0.0.0.0) and
# passes HOSTNAME=<host> to the server itself, overwriting whatever is set
# here. Without the flag the dashboard, and the OAuth tokens behind it, would
# listen on the public IP. Verify after any change:
#   ss -tlnp | grep 20128     # must show 127.0.0.1:20128, never 0.0.0.0
#
# --skip-update stops a service that holds live OAuth credentials from
# upgrading itself unattended; update deliberately with npm -g.
# --log sends the server's output to the journal instead of /dev/null.
ExecStart=/usr/bin/9router --host 127.0.0.1 --port 20128 --no-browser --log --skip-update

# Type=simple means systemd calls this "active" the moment the process is
# spawned, even if it never serves anything. That is exactly what happened on
# the first reboot: cli.js runs ensureTrayRuntime() before it parses argv, that
# shelled out to `npm install systray2` as the service user, the install hung,
# and the unit sat "active" for minutes without a listening socket. Pre-install
# systray2 into the package as root so the install never runs:
#   cd /usr/lib/node_modules/9router && npm install systray2@2.1.4 --no-save
# and fail the unit if the port is not up, so a hang restarts instead of lying.
ExecStartPost=/bin/bash -c 'for i in $(seq 1 30); do ss -ltn | grep -q "127.0.0.1:20128" && exit 0; sleep 2; done; echo "9router did not listen within 60s" >&2; exit 1'

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
# OAuth tokens and quota state live in the SQLite db here.
ReadWritePaths=/home/agent/.9router

[Install]
WantedBy=multi-user.target
