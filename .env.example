# Copy to .env and fill in. Never commit the filled-in version.
# On the server: chmod 600 .env   (systemd reads it as EnvironmentFile)
#
# systemd parses this file itself: plain KEY=value lines, no `export`, no
# quotes around values, no ${VAR} expansion.
#
# Everything here that was ever committed to the public repo must be rotated
# before it goes back into service.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Models: every call goes through 9router on localhost ---
# Provider accounts (Claude and Codex subscriptions, cheap and free tiers) are
# connected in the 9router dashboard, not here. This app only needs the
# router's address, an API key issued by that dashboard, and the name of the
# combo to use.
#
# Keep this pointed at the volume combo (cheap -> free) so unattended jobs
# never spend a subscription's quota. The subscriptions are for interactive
# work: Claude Code, and deploy/brain.sh.
VOLUME_BASE_URL=http://127.0.0.1:20128/v1
VOLUME_API_KEY=
VOLUME_MODEL=volume

# --- Kiro / UniPV (the Moodle scraper) ---
# Empty on purpose. The scraper stays dormant - and Chrome never starts, which
# matters on a 4 GB box - until both of these are set. Fill them in and
# restart the service to switch it on.
#UNIPV_USERNAME=
#UNIPV_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Optional — sensible defaults apply when these are left empty
# ─────────────────────────────────────────────────────────────

# Server Chrome, for the Kiro scraper. Leave CHROMEDRIVER_PATH empty and
# webdriver-manager fetches a driver matching the installed Chrome, caching it
# under the service's HOME (/var/cache/ai-assistant).
CHROME_BINARY=/usr/bin/google-chrome
#CHROMEDRIVER_PATH=

# Where the brain-tier queue lives.
#ESCALATION_QUEUE=data/escalations.jsonl

# ── Leads (phase 2) ─────────────────────────────────────────────────────────
#LEADS_DB=data/leads.db
#SCAN_AT=03:00                  # overnight scan, local time
#DIGEST_AT=08:10                # the list lands after the email briefing
#SCAN_BATCH=25                  # leads per overnight run
#SCAN_MOBILE=1                  # 0 skips Chrome, halving the memory a run needs
#SCAN_SLOW_SECONDS=4            # above this, "slow" is a finding
#SCAN_CERT_WARN_DAYS=21
#SCAN_CHECK_ENGLISH=0           # noisy; only for tourist-facing businesses
#MAX_WHATSAPP_PER_DAY=25        # how many WhatsApp links the digest offers
#WHATSAPP_WAIT_DAYS=2           # no reply -> email
#EMAIL_WAIT_DAYS=3              # no reply -> call
#FOLLOW_UP_DAYS=4               # one follow-up, then cold
#OUTREACH_SIGNATURE=            # appended to approved emails

# Direct-to-provider fallback, for running this on a laptop with no router.
# Leave empty on the server: the router owns the accounts.
#GROQ_API_KEY=
#GEMINI_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile
#GEMINI_MODEL=gemini-2.0-flash
#GROQ_SMALL_MODEL=llama-3.1-8b-instant

# Replace the whole chain (JSON list of {name, base_url, key_env, model}).
# Give unattended jobs a fallback so a capped free tier degrades the briefing
# instead of failing it. MUST be single-quoted: both systemd's EnvironmentFile
# parser and `source` strip unquoted double quotes, leaving invalid JSON and a
# silent fall back to the default chain.
# Note: ChatGPT accounts cannot use cx/gpt-5.4-mini or the codex models
# through Codex; cx/gpt-5.5, cx/gpt-6-astra and cc/claude-haiku-* do answer.
#VOLUME_CHAIN='[{"name":"grok-free","base_url":"http://127.0.0.1:20128/v1","key_env":"VOLUME_API_KEY","model":"gcli/grok-4.6"},{"name":"haiku-fallback","base_url":"http://127.0.0.1:20128/v1","key_env":"VOLUME_API_KEY","model":"cc/claude-haiku-4-5-20251001"}]'
