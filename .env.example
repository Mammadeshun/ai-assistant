# Copy to .env and fill in. Never commit the filled-in version.
# On the server: chmod 600 .env   (systemd reads it as EnvironmentFile)
# All of these were previously hardcoded in a PUBLIC repo and must be rotated.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Volume tier (free models) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- UniPV / Kiro ---
UNIPV_USERNAME=
UNIPV_PASSWORD=

# --- 9router ---
# Dashboard auth. Generate with: openssl rand -hex 32
JWT_SECRET=

# ─────────────────────────────────────────────────────────────
# Optional — sensible defaults apply when these are left empty
# ─────────────────────────────────────────────────────────────

# Volume-tier models. The chain falls through on rate limits:
# groq -> gemini -> groq-small. Override individual links here.
#GROQ_MODEL=llama-3.3-70b-versatile
#GEMINI_MODEL=gemini-2.0-flash
#GROQ_SMALL_MODEL=llama-3.1-8b-instant

# Send volume traffic through 9router instead of straight to the providers.
# Must stay on localhost — the dashboard holds your OAuth tokens.
#VOLUME_BASE_URL=http://127.0.0.1:20128/v1
#VOLUME_API_KEY=
#VOLUME_MODEL=default

# Replace the whole chain (JSON list of {name, base_url, key_env, model}).
#VOLUME_CHAIN=

# Server Chrome, for the Kiro scraper. Set these and the scraper stops
# downloading a driver on every run.
#CHROME_BINARY=/usr/bin/google-chrome
#CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Where the brain-tier queue lives.
#ESCALATION_QUEUE=data/escalations.jsonl
